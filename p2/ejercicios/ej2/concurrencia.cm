/* Ejercicio 2. concurrencia.cm (entorno JBACI) */

const int N = 10;
semaphore s, c, p;

void producir() {
    /* Generar producto */
}

void anyadir_buffer() {
    /* Insertar producto en el buffer */
}

void coger_buffer() {
    /* Extraer producto del buffer */
}

void consumir() {
    /* Consumir producto */
}

void productor() {
    while (1) {
        producir();
        wait(p); /* Desbloquear tras "n" veces */
        wait(s);
        anyadir_buffer();
        signal(s);
        signal(c);
    }
}

void consumidor() {
    while (1) {
        wait(c);
        wait(s);
        coger_buffer();
        signal(s);
        signal(p); /* Desbloquear al productor */
        consumir();
    }
}

void main() {
    initialsem(s,1);
    initialsem(c,0);
    initialsem(p,N);
    cobegin {
        productor();
        consumidor();
    }
}