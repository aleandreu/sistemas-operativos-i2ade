/* Ejercicio 2. concurrencia.cm (entorno JBACI) */

#include "gdefs.cm"

const int BUFFER_X = 100;
const int BUFFER_Y = 200;

const int PRODUCTOR_ID = 100;
const int CONSUMIDOR_ID = 101;

const int N = 3;
semaphore s, c, p;

int buffer[N];
int entrada = 0;
int salida = 0;
int dato = 1; // Numero a meter

void producir() {
    cout << "Produce " << dato << endl;
}

void anyadir_buffer() {
    buffer[entrada] = dato;
    changecolor(entrada + 1, YELLOW);
    entrada = (entrada+1) % N;
    dato = dato+1;
}

int coger_buffer() {
    int extraido;

    extraido = buffer[salida];
    buffer[salida] = 0;
    changecolor(salida + 1, BLUE);
    salida = (salida+1) % N;

    return extraido;
}

void consumir(int extraido) {
    cout << "Consume " << extraido << endl;
}

void productor() {
    while (1) {
        producir();
        wait(p); /* Desbloquear tras "n" veces */
        wait(s);

        changecolor(PRODUCTOR_ID, WHITE);
        anyadir_buffer();
        changecolor(PRODUCTOR_ID, GREEN);

        signal(s);
        signal(c);
    }
}

void consumidor() {
    int extraido;

    while (1) {
        wait(c);
        wait(s);

        changecolor(CONSUMIDOR_ID, WHITE);
        extraido = coger_buffer();
        changecolor(CONSUMIDOR_ID, RED);
        
        signal(s);
        signal(p); /* Desbloquear al productor */
        consumir(extraido);
    }
}

void crear_buffer_grafico() {
    int i;

    for (i = 0; i < N; i = i + 1) {
        create(i + 1, RECTANGLE, BLUE, BUFFER_X + i * 40, BUFFER_Y, 30, 30);
    }
    create(PRODUCTOR_ID, CIRCLE, GREEN, BUFFER_X - 60, BUFFER_Y, 30, 30);
    create(CONSUMIDOR_ID, CIRCLE, RED, BUFFER_X + N * 40 + 30, BUFFER_Y, 30, 30);
}

void main() {
    initialsem(s,1); /* Seccion critica */
    initialsem(c,0);
    initialsem(p,N);

    crear_buffer_grafico();

    cobegin {
        productor();
        consumidor();
    }
}